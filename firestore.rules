rules_version = '2';
// Alborg Scan Business Review — Firestore security rules
// • Only signed-in users with a VERIFIED email can be members.
// • Members (members/{email}) can read published data; admins can publish and manage access.
// • Keep the built-in admin list in sync with ADMIN_EMAILS in js/app.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberDoc() { return /databases/$(database)/documents/members/$(myEmail()); }
    function builtInAdmin() { return verified() && myEmail() in ['appmakeregypt@gmail.com', 'mostafa.hegab83@gmail.com']; }
    function isMember() { return verified() && exists(memberDoc()); }
    function isAdmin() { return builtInAdmin() || (isMember() && get(memberDoc()).data.role == 'admin'); }

    match /members/{email} {
      allow get: if verified() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.role in ['admin', 'viewer'];
      allow delete: if isAdmin() && email != myEmail();   // an admin cannot remove themselves
    }

    match /periods/{period} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin() && period.matches('^[0-9]{4}-[0-9]{2}$');
      match /sheets/{sheet} {
        allow read: if isMember() || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
